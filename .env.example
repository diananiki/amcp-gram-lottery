# Use testnet for learning. Mainnet uses real coins.
NETWORK=testnet
# Wallet recovery words, separated by spaces. Never share them.
WALLET_MNEMONIC=
# Optional TON Center API key for the selected network.
TONCENTER_API_KEY=

# Optional deployment ID (uint256). Leave blank for a new random ID.
LOTTERY_SALT=
# Optional deadline as Unix time in seconds, not milliseconds.
# Example: 1893456000 means 2030-01-01 at 00:00 UTC. Use a future time.
# Leave blank to use the current time plus LOTTERY_DURATION_SECONDS.
LOTTERY_DEADLINE=
# Ticket sales duration in seconds. 86400 seconds is one day.
LOTTERY_DURATION_SECONDS=86400

# Amounts below are in GRAM, not nano-units.
# Coins sent to the lottery during deployment.
DEPLOY_VALUE=0.2
# Extra wallet balance required above the message value to help cover fees.
# This is a buffer, not an exact fee estimate.
GAS_BUFFER=0.05
# Extra coins sent with a purchase. The contract returns extra payment, less fees.
BUY_EXTRA=0.05
# Coins sent with a request to draw winners.
DRAW_VALUE=0.15
# Coins sent with a request to refund tickets.
REFUND_VALUE=0.05

# Maximum number of confirmation checks before reporting a timeout.
POLL_ATTEMPTS=40
# Time between checks in milliseconds.
POLL_INTERVAL_MS=3000

# Optional lottery address for read, buy, draw, and refund commands.
# Leave blank to use deployments/testnet.json or deployments/mainnet.json,
# depending on NETWORK. Build files do not contain deployment addresses.
LOTTERY_ADDRESS=
